{
  "name": "defi-market-intel",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-chain DeFi price and liquidity intelligence.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @defi-market-intel/web dev",
    "build": "pnpm --filter @defi-market-intel/web build",
    "start": "pnpm --filter @defi-market-intel/web start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @defi-market-intel/core typecheck && pnpm --filter @defi-market-intel/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "audit:production": "pnpm audit --prod"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@next/eslint-plugin-next": "^16.3.2",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.15.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
