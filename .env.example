# Copy this file to .env and set only the services you intend to use.
# Never expose provider keys, RPC URLs with embedded credentials, or database
# credentials through NEXT_PUBLIC_* variables or commit them to the repository.

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
MARKET_PROVIDER_TIMEOUT_MS=8000

# Server-side market-data providers currently used by the web runtime
DEFILLAMA_API_BASE_URL=https://coins.llama.fi
DEXSCREENER_API_BASE_URL=https://api.dexscreener.com

# Required only for Prisma database commands after a persistence workflow is enabled.
DATABASE_URL=postgresql://defi:defi_local_only@localhost:5432/defi_market_intel?schema=public

# Optional local Docker Compose database settings. These are development-only
# values; set a strong, deployment-specific password outside this file.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
REDIS_PORT=6379
